{
  "name": "bookstayx-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BookStayX API and Supabase PostgreSQL backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-backend.js",
    "cloudinary:check": "node scripts/check-cloudinary.js",
    "db:check": "node scripts/check-db.js",
    "db:init": "node scripts/init-db.js",
    "db:seed:catalogue": "node scripts/seed-catalogue.js",
    "test": "node --test --test-isolation=none tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "npm:bcryptjs@^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "paytmchecksum": "^1.5.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.5",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
