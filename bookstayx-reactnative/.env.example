# Automatically uses localhost on web and the Expo development host on devices.
EXPO_PUBLIC_API_BASE_URL=auto
EXPO_PUBLIC_ENABLE_DEV_LOGIN=true

# Optional explicit Android-emulator override:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5001/api

# Required before live booking initiation is enabled.
EXPO_PUBLIC_BOOKING_OWNER_PHONE=
EXPO_PUBLIC_BOOKING_ADMIN_PHONE=
