# Local iOS simulator / web:
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Android emulator uses the host loopback alias instead:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5001/api

# Required before live booking initiation is enabled.
EXPO_PUBLIC_BOOKING_OWNER_PHONE=
EXPO_PUBLIC_BOOKING_ADMIN_PHONE=
