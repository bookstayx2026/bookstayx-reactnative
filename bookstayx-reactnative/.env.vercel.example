# ==============================================================================
# BookStayX — Master Environment Template for Single Vercel Project
# Repository: bookstayx2026/bookstayx-reactnative
# Root Directory: bookstayx-reactnative
# ==============================================================================
# This template lists all environment variables for the combined BookStayX
# Expo static web frontend and Express serverless API in a SINGLE Vercel project.
#
# CONFIGURE IN VERCEL:
# Project Settings -> Environment Variables
#
# SECURITY ARCHITECTURE:
# 1. Variables prefixed with EXPO_PUBLIC_ are bundled into client-side web JS.
#    NEVER put database passwords, JWT secrets, or private API keys in EXPO_PUBLIC_.
# 2. All other variables remain strictly server-side and accessible ONLY to the
#    serverless API (api/index.js).
# ==============================================================================

# ==============================================================================
# 1. FRONTEND / EXPO PUBLIC CONFIGURATION (Web Client)
# ==============================================================================

# [REQUIRED] Relative /api path when deployed under the same domain in one Vercel project.
# Eliminates CORS issues between frontend web client and serverless API.
# In local development: "auto" infers localhost:5001/api.
EXPO_PUBLIC_API_BASE_URL=/api

# [OPTIONAL] Dev login bypass.
# MUST BE "false" or omitted in production.
EXPO_PUBLIC_ENABLE_DEV_LOGIN=false

# [OPTIONAL] Default property owner contact phone (10-digit Indian mobile number).
# Fallback contact for customer booking inquiries if property owner phone is unlisted.
EXPO_PUBLIC_BOOKING_OWNER_PHONE=

# [OPTIONAL] Default platform admin contact phone (10-digit Indian mobile number).
# Fallback support contact for customer inquiries.
EXPO_PUBLIC_BOOKING_ADMIN_PHONE=


# ==============================================================================
# 2. BACKEND / SERVERLESS API CORE CONFIGURATION (Server-side)
# ==============================================================================

# [OPTIONAL] Node environment mode.
# Set to "production" in Vercel to enforce production security rules, strict CORS,
# and disable development bypasses. (Local default: development)
NODE_ENV=production

# [OPTIONAL] HTTP port for local standalone Express server.
# Defaults to 5001 locally. Omit in Vercel (Vercel assigns the port dynamically).
PORT=5001

# [REQUIRED IN PROD] Canonical URL of the deployed application.
# Used for payment return redirects, e-ticket web view links, and admin emails.
FRONTEND_URL=https://your-domain.vercel.app

# [OPTIONAL] Public web origin used for generating referral links and QR codes.
# Defaults to FRONTEND_URL if unset.
PUBLIC_APP_URL=https://your-domain.vercel.app

# [REQUIRED IN PROD] Comma-separated list of allowed browser origins for CORS.
# Must include your production Vercel URL and any custom domains.
CORS_ORIGINS=https://your-domain.vercel.app,https://bookstayx.com

# [OPTIONAL] In-process scheduled background jobs (OTP cleanup, token cleanup, commissions).
# MUST BE "false" on Vercel Serverless because serverless functions do not stay resident.
# (Scheduled tasks should be triggered via Vercel Crons or external webhooks).
ENABLE_BACKGROUND_JOBS=false

# [OPTIONAL] Backend dev login bypass endpoint enablement.
# MUST BE "false" in production (automatically suppressed when NODE_ENV=production).
ENABLE_DEV_LOGIN=false


# ==============================================================================
# 3. DATABASE (POSTGRESQL / SUPABASE) (Server-side)
# ==============================================================================

# [REQUIRED] PostgreSQL database connection string.
# On Vercel Serverless, you MUST use the Supabase Transaction Pooler (port 5432 or 6543)
# to prevent connection exhaustion. Ensure password is URL-encoded if special characters exist.
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# [OPTIONAL] Enable SSL for PostgreSQL connection.
# Must be "true" for Supabase cloud connections. (Defaults to true in production)
DATABASE_SSL=true

# [OPTIONAL] Maximum connections in the pg Pool per serverless function instance.
# Keep low (3 to 5) on Vercel serverless to avoid exceeding Supabase pooler limits.
DATABASE_POOL_MAX=5


# ==============================================================================
# 4. AUTHENTICATION AND SESSION SECURITY (Server-side)
# ==============================================================================

# [REQUIRED] Strong secret key for signing JSON Web Tokens (customer, owner, admin).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=generate-a-strong-64-character-random-secret

# [OPTIONAL] JWT access token lifespan (e.g., "15m", "1h", "7d").
# Defaults to "7d" locally; recommend "15m" to "1h" when refresh tokens are active.
ACCESS_TOKEN_EXPIRY=7d

# [OPTIONAL] Session refresh token lifespan in days. Defaults to 30.
REFRESH_TOKEN_EXPIRY_DAYS=30

# [REQUIRED] HMAC secret key used to hash OTPs before database storage.
# MUST be different from JWT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
OTP_HMAC_SECRET=generate-a-different-strong-64-character-random-secret

# [OPTIONAL] Test OTP bypass.
# When true, allows test OTP "123456" and relaxes rate limits. MUST BE "false" in production.
OTP_TEST_MODE=false


# ==============================================================================
# 5. CLOUD MEDIA STORAGE (CLOUDINARY) (Server-side)
# ==============================================================================

# [REQUIRED FOR PHOTO UPLOADS] Cloudinary Cloud Name.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# [REQUIRED FOR PHOTO UPLOADS] Cloudinary API Key (numeric string).
CLOUDINARY_API_KEY=your-cloudinary-api-key

# [REQUIRED FOR PHOTO UPLOADS] Cloudinary API Secret. Keep server-side only.
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# [OPTIONAL] Cloudinary folder name for BookStayX uploads. Defaults to "bookstayx".
CLOUDINARY_FOLDER=bookstayx


# ==============================================================================
# 6. PAYMENT GATEWAYS (Server-side)
# ==============================================================================

# [OPTIONAL] Payment gateway provider: "razorpay" for live payments, "mock" for dev/staging.
# NOTE: Production backend refuses "mock" gateway payments by policy.
PAYMENT_PROVIDER=mock

# [OPTIONAL] Referral and vendor payout provider: "manual" or "razorpayx".
PAYOUT_PROVIDER=manual

# [OPTIONAL] Secret for signing tamper-proof payment checkout tokens.
# Falls back to OTP_HMAC_SECRET if omitted.
PAYMENT_CHECKOUT_SECRET=generate-another-strong-random-secret

# [REQUIRED IF PAYMENT_PROVIDER=razorpay] Razorpay API Key ID (rzp_live_... or rzp_test_...).
RAZORPAY_KEY_ID=

# [REQUIRED IF PAYMENT_PROVIDER=razorpay] Razorpay API Key Secret. Server-side only.
RAZORPAY_KEY_SECRET=

# [OPTIONAL] Razorpay Webhook Secret for validating payment status webhooks.
RAZORPAY_WEBHOOK_SECRET=

# [REQUIRED IF PAYOUT_PROVIDER=razorpayx] RazorpayX Business Account Number.
RAZORPAY_ACCOUNT_NUMBER=

# [OPTIONAL] RazorpayX specific API keys (if different from primary gateway keys).
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# [LEGACY / OPTIONAL] Paytm Payment Gateway credentials (if enabled).
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_CHANNEL_ID=WEB
PAYTM_GATEWAY_URL=


# ==============================================================================
# 7. OTP AND MESSAGING (SMS & WHATSAPP) (Server-side)
# ==============================================================================

# [REQUIRED IN PROD FOR SMS] MSG91 Authentication Key for sending OTP SMS in India.
MSG91_AUTH_KEY=

# [REQUIRED IN PROD FOR SMS] MSG91 Approved DLT Flow Template ID.
MSG91_TEMPLATE_ID=

# [OPTIONAL] MSG91 OTP variable name in flow template (defaults to "otp").
MSG91_OTP_VAR=otp

# [OPTIONAL] WhatsApp Business Cloud API credentials for automated confirmations.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_APP_SECRET=


# ==============================================================================
# 8. ADMINISTRATIVE & BOOKING NOTIFICATIONS (Server-side)
# ==============================================================================

# [OPTIONAL] Administrator mobile number for booking notification alerts.
ADMIN_PHONE=9999999999

# [OPTIONAL] Fallback administrative booking phone.
BOOKING_ADMIN_PHONE=


# ==============================================================================
# 9. BUILD & LOCAL OPERATIONAL HELPERS (Build / Scripts)
# ==============================================================================

# [OPTIONAL] Set to "true" during Vercel static build to avoid spawning local backend.
BOOKSTAYX_SKIP_BACKEND_AUTOSTART=true
