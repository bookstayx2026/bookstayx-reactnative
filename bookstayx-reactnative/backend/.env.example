PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:8081
# Public web/PWA origin used when generating referral links and QR codes.
PUBLIC_APP_URL=http://localhost:8081

# Supabase Session Pooler (IPv4-compatible)
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Production uses this exact allowlist. Development also accepts loopback and
# private-LAN browser origins on any port so Expo can safely select a free port.
# Native Expo requests do not send an Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ENABLE_BACKGROUND_JOBS=false
ENABLE_DEV_LOGIN=true

# Payments: keep mock/manual until Razorpay credentials are available.
# Production refuses mock gateway payments.
PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=manual
PAYMENT_CHECKOUT_SECRET=generate-another-long-random-secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX Payouts (may use different API keys from the gateway account)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Cloudinary image storage. Keep the API secret server-side only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=bookstayx

JWT_SECRET=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
OTP_HMAC_SECRET=generate-a-different-long-random-secret
OTP_TEST_MODE=false
